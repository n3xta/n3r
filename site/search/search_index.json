{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"n3r","text":""},{"location":"brainstorm/","title":"\u94fe\u63a5\u5927\u4e71\u7096","text":"<p>\u3010\u6c89\u6d78\u5f0f\u66b4\u96e8\u9732\u8425\uff5c\u9a7e\u9a76\u7c89\u8272\u5c0f\u8f66\u8fdb\u5165\u68ee\u6797\u516c\u56ed\uff0c\u8f66\u5185\u542c\u96e8\uff0c\u6781\u5ea6\u89e3\u538b-\u54d4\u54e9\u54d4\u54e9\u3011 https://b23.tv/e6HT55X</p> <p>https://toss.im/tossface/all</p> <p>https://toss.im/tossface/universe</p> <p>\u3010Let's Game It Out\u719f\u8089\u3011\u6211\u5c06\u4e00\u8d9f\u6b22\u5feb\u7684\u516c\u8def\u6e38\u5316\u4e3a\u4e86\u4e00\u573a\u5669\u68a6\u4e4b\u65c5 - \u957f\u9014\u65c5\u884c https://www.bilibili.com/video/BV1FL4y1A7Vz/</p>"},{"location":"game-design/","title":"\u521d\u7248\u7b56\u5212\u6848","text":""},{"location":"game-design/#_2","title":"\u73a9\u6cd5","text":"<p>\u6e14\u6c11\u8d5a\u94b1\u7684\u662f\u9493\u4e0a\u6765\u7684\u8fd9\u4e2a\u884c\u4e3a\u3002 \u4fdd\u5b89\u8d5a\u94b1\u7684\u662f\u653b\u51fb\u5230\u6e14\u6c11\u7684\u8fd9\u4e2a\u884c\u4e3a\uff0c\u6240\u4ee5\u8eb2\u732b\u732b\u662f\u6709\u7528\u7684\u3002\u7528\u62f3\u5934\u6253\u4e5f\u80fd\u8d5a\u94b1\u3002 \u6240\u6709\u4eba\u76ee\u6807\u90fd\u662f\u8fd8\u4e0a\u6b20\u7684\u94b1\u3002\u6ca1\u6b20\u94b1\u7684\u8981\u88ab\u9001\u53bb\u5f53\u9ed1\u5974\u77ff\u5de5\u3002</p> <p>\u6240\u6709\u4e1c\u897f\u90fd\u662f\u53ef\u4ee5\u76f8\u4e92\u8fde\u63a5\u7684\u3002 \u9c7c\u4f5c\u4e3a\u7269\u7406\u6a21\u5757\u662f\u94f0\u94fe\u3002\u9c7c\u7aff/\u5c9b\u4e0a\u7684\u5404\u79cd\u4e1c\u897f/\u4fdd\u5b89\u8239/\u8f6e\u5b50/\u5b50\u5f39\u662f\u521a\u4f53\u3002\u9c7c\u7ebf\u662f\u5f39\u7c27\u3002\u53d1\u52a8\u673a\u53ef\u4ee5\u65cb\u8f6c\uff08\u88c5\u5728\u8239\u540e\u9762\u8f6c\u8f6e\u5b50\u9a7e\u9a76\uff0c\u6216\u8005\u653e\u9c7c\u7aff\u4e0a\u7528\u6765\u6536\u653e\u7ebf\uff09\u3002\u624b\u67aa\u53ef\u4ee5\u53d1\u5c04\u4e1c\u897f\uff0c\u4f46\u662f\u9700\u8981\u6709\u4e00\u4e9b\u8f6c\u6298\u524a\u5f31\u4e00\u4e0b\u3002 \u4eba\u53ef\u4ee5\u88ab\u521a\u4f53\u548c\u5176\u4ed6\u4eba\u6253\u6655\u3002\u6253\u6655\u4f1a\u6d6a\u8d39\u4f60\u4e00\u70b9\u65f6\u95f4\u3002</p> <p>\u5730\u56fe\u662f\u7a0b\u5e8f\u5316\u751f\u6210\u3002~~\u64cd\u4f5c\u6709\u70b9\u50cfpeak\uff0c\u4e00\u6b21\u53ea\u80fd\u62ff\u4e00\u4e2a\u4e1c\u897f\uff0c\u6240\u6709\u64cd\u4f5c\u90fd\u8981\u65f6\u95f4\u3002~~</p>"},{"location":"game-design/#_3","title":"\u9c7c\u7ebf","text":"<p>\u51b7\u72d7\u5728\u60f3\u8981\u4e0d\u8981\u9493\u9c7c\u8fd9\u5757\u505a\u70b9\u6df1\u5ea6\uff0c\u6bd4\u5982\u505a\u4e0d\u540c\u79cd\u7c7b\u548c\u5927\u5c0f\u7684\u9c7c\uff0c\u4f1a\u6709\u4e0d\u540c\u7684\u6548\u679c\uff08\u7206\u70b8\uff0c\u9760\u8fd1\u53d1\u51fa\u566a\u97f3\uff0c\u9760\u8fd1\u660f\u7761\uff0c\u6307\u5411\u6700\u8fd1\u7684\u6e14\u6c11\uff0c\u672b\u5f71\u73cd\u73e0\u7b49\u7b49\uff09: \u9c7c\u7ebf\u52a0\u4e2a\u5bfc\u7ebf\u7684\u529f\u80fd\uff0c\u9c7c\u53ef\u4ee5\u53d1\u7535\u5b50\u4fe1\u53f7\u89e6\u53d1\u5bfc\u7ebf\u8fde\u63a5\u7684\u522b\u7684\u9c7c</p> <p>\u7ebf\u7684\u5206\u7ea7\u4f1a\u51b3\u5b9a\u7535\u4fe1\u53f7\u7684\u4f20\u8f93\u901f\u5ea6 \u9c7c\u94a9\u7684\u5206\u7ea7\u4f1a\u51b3\u5b9a\u9c7c\u54ac\u94a9\u7684\u65f6\u95f4\u500d\u7387 \u9c7c\u9975\u7684\u5206\u7ea7\u4f1a\u51b3\u5b9a\u9c7c\u7684\u79cd\u7c7b\u548c\u54ac\u94a9\u65f6\u95f4 \u9c7c\u8f6e\u7684\u5206\u7ea7\u4f1a\u51b3\u5b9a\u65cb\u8f6c\u7684\u901f\u5ea6</p> <p>\u4fe1\u53f7\u4f20\u8f93\u662f\u4e00\u4e2a\u5185\u90e8\u673a\u5236\u3002\u4e0d\u4f1a\u663e\u793a\u5728\u7ebf\u4e0a\u3002 \u9c7c\u8f6e\u662f\u4e00\u79cd\u53ef\u4ee5\u624b\u52a8\u64cd\u63a7\u7684\u53d1\u52a8\u673a</p> <p>\u4eba\uff1a\u62ff\u7740\u7ebf\u7684\u4e00\u7aef\u4f1a\u5728ui\u4e0a\u663e\u793a\u5f53\u524d\u4fe1\u53f7 \u9c7c\u94a9\uff1a\u9c7c\u54ac\u94a9\u7684\u65f6\u5019\u4f1a\u53d1\u9001\u4fe1\u53f7 \u6240\u4ee5\u9c7c\u7ebf\u548c\u9c7c\u94a9\u8d8a\u597d\uff0c\u4eba\u9493\u4e0a\u9c7c\u7684\u53cd\u5e94\u65f6\u95f4\u8d8a\u957f</p> <p>\u7ebf\u53ef\u4ee5\u63a5\u5728\u9c7c\u7684\u5634\u5df4&amp;\u5176\u4ed6\u5730\u65b9\u3002\u5634\u5df4\u662f\u8f93\u51fa\uff0c\u5176\u4ed6\u4efb\u4f55\u5730\u65b9\u662f\u8f93\u5165 \u540c\u65f6\u9c7c\u4e5f\u662f\u94f0\u94fe\uff0c\u53ef\u4ee5\u628a\u521a\u4f53\u63a5\u5728\u5634\u5df4\u548c\u5c3e\u5df4\u4e0a\u3002\u8fdb\u884c\u4e24\u8005\u8fde\u63a5\u7684\u65cb\u8f6c\u3002\u9664\u4e86\u51e0\u79cd\u7279\u6b8a\u7684\u9c7c\u4e4b\u5916\uff0c\u5176\u4ed6\u7684\u9c7c\u90fd\u662f\u53ef\u8c03\u6574\u89d2\u5ea6\u7684\u56fa\u5b9a\u94f0\u94fe\u3002 \u5927\u90e8\u5206\u9c7c\u7684\u529f\u80fd\u662f\u4e00\u6b21\u6027\u7684\uff0c\u901a\u8fc7\u4e00\u6b21\u4fe1\u53f7\u4e4b\u540e\u7684\u51e0\u79d2\u5185\u4f1a\u6d88\u5931\u3002</p>"},{"location":"game-design/#_4","title":"\u89d2\u8272","text":""},{"location":"game-design/#_5","title":"\u4fdd\u5b89","text":"<p>\u5728\u6d77\u4e0a\u8df3\u6c34\u6361\u7269\u8d44\u3002\u4e3b\u8981\u6361\u624b\u67aa\u548c\u5403\u7684\u3002\u5403\u7684\u80fd\u52a0\u901f\u3002 \u968f\u65f6\u53ef\u4ee5\u5f00\u8239\u524d\u5f80\u5c9b\u5c7f\u3002 \u4e0a\u5c9b\u540e\uff0c\u6253\u4e2d\u9c7c\u7aff\u3001\u9053\u5177\u3001\u9c7c\u6216\u8005\u4eba\u8d5a\u94b1\u3002\u624b\u67aa\u5b50\u5f39\u6253\u5b8c\uff0c\u624b\u67aa\u5c31\u4f1a\u7206\u70b8\u3002\u8d5a\u7684\u94b1\u7528\u4e8e\u5347\u7ea7buff\uff0c\u83b7\u5f97\u66f4\u597d\u7684\u76d1\u89c6\u88c5\u5907/\u901f\u5ea6\u3002\uff08\u4e0d\u6253\u4eba\u5149\u6253\u5c9b\u4e0a\u7684\u5e9f\u5f03\u8f66\u554a\u5565\u7684\u4e5f\u80fd\u8d5a\u94b1\u3002\u5c9b\u5f88\u5927\uff0c\u53ef\u4ee5\u5077\u5077\u4e0a\u5c9b\u4e0d\u88ab\u53d1\u73b0\uff09</p> <p>\u55ef \u5e94\u8be5\u5c9b\u4e0a\u9ed8\u8ba4\u751f\u6210\u4e00\u4e9b\u5de1\u903b\u673a\u5668\u4eba\u548c\u76d1\u63a7\uff08\u6839\u636e\u5c9b\u5c7f\u5927\u5c0f\u548c\u4eba\u6570\uff09 \u62cd\u5230\u6e14\u6c11\u5c31\u62a5\u8b66 \u4fdd\u5b89\u4e0a\u5c9b\u53ef\u4ee5\u6539\u76d1\u63a7\u4f4d\u7f6e\u548c\u673a\u5668\u4eba\u5de1\u903b\u533a\u57df \u4e00\u4e2a\u91cd\u8981\u7684\u4e1c\u897f\u662f\u8349\u4e1b/\u82a6\u82c7/\u690d\u88ab\u3002</p>"},{"location":"game-design/#_6","title":"\u6e14\u6c11","text":"<p>\u5c9b\u4e0a\u9493\u9c7c\u3002\u9493\u7684\u9c7c\u5403\u6389\u6362\u94b1\uff0c\u6652\u6210\u9c7c\u5e72\u5403\u4e86\u53ef\u4ee5\u52a0\u901f\u3002\u4e5f\u53ef\u4ee5\u9493\u9053\u5177/\u9c7c\u7aff\u3002\u8eab\u4e0a\u7684\u9053\u5177\u8d8a\u591a\u8dd1\u8def\u8d8a\u6162\u3002\u9493\u4e0a\u6765\u7684\u4e1c\u897f\u53ef\u4ee5\u505along drive\u7c7b\u578b\u7684\u8f7d\u5177\uff08\u5c9b\u4e0a\u4e5f\u6709\u5f88\u591a\u96f6\u4ef6\uff09\uff0c\u4e5f\u53ef\u4ee5\u505a\u85cf\u8eab\u4f2a\u88c5\u7b49\u7b49\u3002</p>"},{"location":"game-design/#v2","title":"\u8f7d\u5177\u62fc\u88c5v2\u60f3\u6cd5","text":"<p>\u8f7d\u5177\u7684\u6709\u591a\u4e2a\u4f5c\u7528\uff1a\u66f4\u5feb\u7684\u8fd0\u8f93\u9053\u5177\uff0c\u4f2a\u88c5/\u63a9\u62a4\uff0c\u66f4\u9ad8\u6548\u7387\u7684\u6355\u9c7c\uff08\u7528\u8fde\u6746\u628a\u591a\u4e2a\u9c7c\u7aff\u7684\u9c7c\u8f6e\u8fde\u5728\u4e00\u8d77\uff0c\u5c31\u53ef\u4ee5\u4e00\u6b21\u6027\u9493\u5230\u5f88\u591a\u9c7c\uff09\uff0c\u66f4\u9ad8\u6548\u7387\u7684\u64a4\u79bb\uff08\u76f4\u63a5\u5f00\u8d70\u8f66\u5c31\u4e0d\u7528\u82b1\u65f6\u95f4\u6536\u4e1c\u897f\u4e86\uff09 \u5206\u4e3a\u8f6e\u5b50\uff0c\u8fde\u6746\u548c\u8f7d\u5177\u3002\u8f6e\u5b50\u8fde\u5728\u8f7d\u5177\u4e0a\uff0c\u8fde\u6746\u8fde\u63a5\u591a\u4e2a\u8f6e\u5b50\u8ba9\u4ed6\u4eec\u7684\u8f6c\u52a8\u540c\u6b65\u3002</p> <p>\u6bcf\u4e2a\u8f7d\u5177\u90fd\u6709\u56fa\u5b9a\u7684\u9a91\u4e58\u4f4d\u548c\u8f6e\u5b50\u4f4d</p> <p>\u4e00\u4e2a\u8f7d\u5177\u4f1a\u6839\u636e\u8f6e\u5b50\uff0c\u8f6e\u5b50\u6570\u91cf\u548c\u88c5\u8f7d\u7269\u4ef6\u8ba1\u7b97\u51fa\u4e00\u4e2a\u901f\u5ea6\u56e0\u5b50\uff0c\u4f1a\u5728\u7269\u7406\u8fd0\u7b97\u51fa\u7684\u901f\u5ea6\u7684\u57fa\u7840\u4e0a\u4e58\u4e0a\u8fd9\u4e2a\u6570\u5b57 \u73a9\u5bb6\u53ef\u4ee5\u8f6c\u8f6e\u5b50\uff0cosu\u5927\u8f6c\u76d8\uff0c\u8fd9\u4e5f\u662f\u9493\u9c7c\u7684\u65b9\u6cd5\u3002 \u677f\u6750\u88c5\u8f6e\u5b50\u540e\uff0c\u9700\u8981\u56db\u4e2a\u73a9\u5bb6\u5750\u5728\u4e0a\u9762\u4e00\u8d77\u671d\u524d\u5206\u522b\u6eda\u56db\u4e2a\u8f6e\u5b50\u671d\u524d\uff0c\u624d\u662f\u6700\u9ad8\u901f\u5ea6\u3002\u6709\u4e86\u8fde\u6746\uff0c\u73a9\u5bb6\u65cb\u8f6c\u7684\u901f\u5ea6\u4f1a\u51cf\u6162\uff0c\u4f46\u662f\u80fd\u540c\u65f6\u64cd\u63a7\u5f88\u591a\u4e2a\u8f6e\u5b50\uff0c\u5229\u597d\u7269\u7406\u4e0a\u7684\u8fd0\u4f5c\u3002 \u677f\u6750\u548c\u8f6e\u5b50\u4f1a\u6709\u8ff7\u5f69\u6750\u8d28\u7684\u53d8\u79cd\uff0c\u540c\u65f6\u5c9b\u4e0a\u4e5f\u6709\u5f88\u591a\u5e9f\u5f03\u7684\u8f7d\u5177\u7269\u8d44\u3002\u9700\u8981\u5584\u7528\u4ee5\u8fdb\u884c\u4f2a\u88c5\uff0c\u56e0\u4e3a\u5f88\u591a\u5730\u65b9\u4f1a\u5f88\u72ed\u5c0f\uff0c\u8f66\u4e0d\u8ba9\u8fc7\u53bb\u7684\u3002</p> <p>\u9a91\u4e58\u4f4d\u548c\u8f6e\u5b50\u4f4d\u6ca1\u533a\u522b\u3002\u5927\u90e8\u5206\u8f6e\u5b50\u4e24\u9762\u90fd\u6709\u9a91\u4e58\u4f4d\uff0c\u8fd9\u6837\u5c31\u53ef\u4ee5\u8fde\u7eed\u8fde\u4e1c\u897f</p>"}]}